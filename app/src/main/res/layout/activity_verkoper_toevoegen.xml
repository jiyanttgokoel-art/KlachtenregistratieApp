<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitelVerkoper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verkoper registreren"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitelVerkoper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registreer een verkoper voordat je producten toevoegt."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verkopernaam"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etVerkoperNaam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Voer verkopernaam in"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partijnaam"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPartijNaam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Voer partijnaam in"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partijcontact"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPartijContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Voer e-mailadres of telefoonnummer in"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpslaanVerkoper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verkoper opslaan" />

    </LinearLayout>
</ScrollView>