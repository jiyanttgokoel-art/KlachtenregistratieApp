<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitelKlacht"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klacht registreren"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitelKlacht"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registreer een klacht voor een bestaand product."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvGeenProducten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Er zijn nog geen producten geregistreerd."
            android:textSize="16sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGaNaarProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nieuw product registreren"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datum klacht"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etDatum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kies datum klacht"
            android:textSize="14sp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Omschrijving"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etOmschrijving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Omschrijf de klacht"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BDBDBD"
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:minLines="4"
            android:maxLines="8"
            android:background="@drawable/bg_omschrijving"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnOpslaanKlacht"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klacht opslaan"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBijwerkenKlacht"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klacht bijwerken"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>