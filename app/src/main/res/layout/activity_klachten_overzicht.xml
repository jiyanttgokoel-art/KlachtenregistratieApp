<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitelKlachtenOverzicht"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klachtenoverzicht"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSubtitelKlachtenOverzicht"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bekijk, bewerk of verwijder geregistreerde klachten."
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLegeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Er zijn nog geen klachten geregistreerd."
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnGaNaarKlachtToevoegen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klacht registreren"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/listViewKlachten"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>